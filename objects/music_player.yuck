(deflisten track-title "python3 -u ~/.config/eww/scripts/music_data.py --track-title")
(deflisten track-artist "python3 -u ~/.config/eww/scripts/music_data.py --track-author")
(deflisten track-levels "python3 -u ~/.config/eww/scripts/music_data.py --levels")

(defwidget music_pop []
	(box 
        :class "pop" 
        :orientation "h" 
        :space-evenly "false" 
        :vexpand "false" 
        :hexpand "false"

            (box
                :halign "center" 
                :class "album_image"
                :style "background-image: url(${album_image});"
            )

            (box 
                :orientation "v" 
                :halign "center" 
                :spacing 10
                :space-evenly "false" 
                :vexpand "false" 
                :hexpand "false"
                :class "music_control"
                
                ;; ToDo Change text to relevant
                ;;(label 
                ;;    :halign "center" 
                ;;    :wrap "true" 
                ;;    :limit-width 13 
                ;;    :text track-title
                ;;)
                ;;(label 
                ;;    :halign "center" 
                ;;    :wrap "true" 
                ;;    :limit-width 15 
                ;;    :text track-artist
                ;;)
                (label
                    :class "synth"
                    :text track-levels
                )

                ;; ToDo Scroll bar
                (box 
                    :halign "center" 
                    :vexpand "false" 
                    :hexpand "false" 
                    :space-evenly "false"
                    :class "music_scroll_bar"

                    (scale 
                        :onscroll "" 
                        :min 0 
                        :active "true" 
                        :max 100
                    )
                )

                (box
                    :orientation "h" 
                    :spacing 25
                    :space-evenly "false" 

                    ;; ToDo images and usage of buttons
                    (button :class "button" :style "background-image: url('images/music/shuffle_off.svg');" :onclick "mpc shuffle")

                    (box
                        :orientation "h"
                        :halign "center" 
                        :spacing 5 

                        (button :class "button" :style "background-image: url('images/music/prev.svg');" :onclick "mpc prev")
                        (button :class "button" :style "background-image: url('images/music/play.svg');" :onclick "mpc pause")
                        (button :class "button" :style "background-image: url('images/music/next.svg');" :onclick "mpc next")
                    )

                    (button :class "button" :style "background-image: url('images/music/repeat_off.svg');" :onclick "mpc repeat")
                    
                )
                
            )
    )
)


(defwindow music_win 
    :stacking "fg" 
    :focusable "true" 
    :screen 1 
    :geometry (
        geometry 
        :x "0" 
        :y "5%" 
        :width 400
        :height 104 
        :anchor "top center"
    )
	    (music_pop)
)

(defwindow music_win_dash
    :stacking "fg" 
    :focusable "true" 
    :screen 1 
    :geometry (
        geometry 
        :x "0" 
        :y "0" 
        :width 400
        :height 104 
        :anchor "top right"
    )
	    (music_pop)
)