;; (include "./objects/right.yuck")

(defwidget dashboard_init []
    (box :orientation "h"
    :class "dock"
    )
)

(defwindow dashboard []
    :monitor 0
    :windowtype "dock"
    :geometry (geometry :x "0%"
                        :y "0%"
                        :width "100%"
                        :height "100%"
                        :anchor "top center"
                        )
    :reserve (struts :side "top" :distance "4%")
    
    (dashboard_init)
)